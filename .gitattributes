# Normalize all text files to LF in the repo and working tree
* text=auto eol=lf

# Windows-specific scripts stay CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files — never touch
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.parquet binary
*.zip binary
