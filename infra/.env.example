# infra/.env.example
# Copy this to infra/.env and fill in values. NEVER commit infra/.env to git.
#
# Usage: `make dev-up` reads infra/.env automatically.
#        For native WSL2 dev, source it: `set -a && source infra/.env && set +a`

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development

# ── Logging (shared by app / worker / poller) ─────────────────────────────────
# Level for all three processes: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
# Output format: console (readable lines) | json (JSON Lines).
# Leave empty for auto: console in development, json in production.
LOG_FORMAT=

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=REPLACE_ME_generate_a_random_hex_string

# Auth mode: 'password' for v1 MVP fallback, 'oidc' for production Entra ID
AUTH_MODE=password

# Entra ID (Azure AD) OIDC settings. Required for production auth.
ENTRA_TENANT_ID=4dcbd443-2dae-4065-b806-17d9c7781f58
ENTRA_CLIENT_ID=e2e1c2d1-c25e-4daa-9faf-65a07ea94460
ENTRA_CLIENT_SECRET=""
ENTRA_REDIRECT_URI=http://localhost:8000/auth/callback
ENTRA_ADMIN_OBJECT_ID=1f2f07a2-b148-4187-813c-420f13c7a16c


# ── Redis ─────────────────────────────────────────────────────────────────────
# In docker mode: Redis runs inside linux-box, so use 127.0.0.1 (localhost inside the container).
# In native WSL2 mode: Redis also runs locally, so same URL.
REDIS_URL=redis://127.0.0.1:6379/0

# ── SQL Server SA password (docker sqlserver container) ───────────────────────
# Must meet SQL Server complexity requirements: min 8 chars, upper + lower + digit + symbol.
#
# IMPORTANT — keep every password below in sync with this one. All three
# connections (WORKBENCH / EXPOSURE / LOSS) authenticate as the SAME `sa` login
# on the SAME server, so MSSQL_SA_PASSWORD and all MSSQL_*_PASSWORD values MUST
# be identical. If you rotate this password, change all four together. A mismatch
# lets one connection work while the others fail with:
#     Login failed for user 'sa'. (18456)
# (Can't use ${MSSQL_SA_PASSWORD} interpolation here: docker-compose's `env_file`
#  passes values literally, so the four must be spelled out.)
MSSQL_SA_PASSWORD=Clarity0821!

# ── WORKBENCH database connection ─────────────────────────────────────────────
# In docker mode: sqlserver is the hostname (Docker internal DNS).
# In native WSL2 mode: use localhost (SQL Server container maps port 1433 to host).
MSSQL_WORKBENCH_SERVER=sqlserver
MSSQL_WORKBENCH_PORT=1433
MSSQL_WORKBENCH_DATABASE=rwb_workbench
MSSQL_WORKBENCH_USER=sa
MSSQL_WORKBENCH_PASSWORD=Clarity0821!
MSSQL_WORKBENCH_POOL_SIZE=10
MSSQL_WORKBENCH_POOL_MAX_OVERFLOW=20

# ── EXPOSURE database connection ──────────────────────────────────────────────
MSSQL_EXPOSURE_SERVER=sqlserver
MSSQL_EXPOSURE_PORT=1433
MSSQL_EXPOSURE_DATABASE=rwb_exposure
MSSQL_EXPOSURE_USER=sa
MSSQL_EXPOSURE_PASSWORD=Clarity0821!
MSSQL_EXPOSURE_POOL_SIZE=5
MSSQL_EXPOSURE_POOL_MAX_OVERFLOW=5

# ── LOSS database connection ───────────────────────────────────────────────────
MSSQL_LOSS_SERVER=sqlserver
MSSQL_LOSS_PORT=1433
MSSQL_LOSS_DATABASE=rwb_loss
MSSQL_LOSS_USER=sa
MSSQL_LOSS_PASSWORD=Clarity0821!
MSSQL_LOSS_POOL_SIZE=5
MSSQL_LOSS_POOL_MAX_OVERFLOW=5

# ── DATABRIDGE connection (Moody's — read-only, never migrated) ───────────────
# Fill in with Moody's-provided credentials. Not required for local dev without IRP.
MSSQL_DATABRIDGE_SERVER=
MSSQL_DATABRIDGE_PORT=1433
MSSQL_DATABRIDGE_DATABASE=
MSSQL_DATABRIDGE_USER=
MSSQL_DATABRIDGE_PASSWORD=

# ── Global SQL Server settings ────────────────────────────────────────────────
MSSQL_DRIVER="ODBC Driver 18 for SQL Server"
MSSQL_TRUST_CERT=yes
MSSQL_TIMEOUT=30

# ── IRP / irp-integration (Risk Modeler) ──────────────────────────────────────
# IRPClient() reads ALL of its config straight from the environment (no constructor
# args), so these must be EXPORTED into the process env — not merely read by
# pydantic. For native WSL2 dev:  set -a && source infra/.env && set +a
# Required for IRP-connected features; not needed for local dev without IRP.
#
# Always required:
RISK_MODELER_BASE_URL=
RISK_MODELER_RESOURCE_GROUP_ID=
#
# Authentication — pick ONE strategy; the client auto-selects from what is set:
#   • Bearer login (username/password): set all THREE of TENANT_NAME + USERNAME +
#     PASSWORD and leave RISK_MODELER_API_KEY empty. The client logs in at
#     construction for a short-lived (1h) bearer token and re-logs in reactively
#     on a 401. This is the strategy we use.
#   • API key: set RISK_MODELER_API_KEY only. If both sets are present the API key
#     WINS — so leave it empty to use bearer login.
# S3 import/export staging needs no AWS creds here: the wheel fetches short-lived
# upload credentials from Risk Modeler per transfer (worker host needs S3 egress).
RISK_MODELER_TENANT_NAME=
RISK_MODELER_USERNAME=
RISK_MODELER_PASSWORD=
RISK_MODELER_API_KEY=

# Hazard data version sent on every geohaz launch. Bump when Moody's ships a
# new version.
HAZARD_DATA_VERSION=25.0

# ── Shared drive (read-only broker file source, Iteration 2) ──────────────────
# Root the EDM/RDM import browse lists files under. The app never writes/moves/
# deletes here. Point at the mounted broker share; leave empty for dev without one.
SHARED_DRIVE_ROOT=

# ── Background queue / poller (Iteration 2) ───────────────────────────────────
# rwb_job heartbeat cadence + the staleness window the reconciler reclaims on.
RWB_HEARTBEAT_INTERVAL_SECS=30
RWB_HEARTBEAT_STALE_SECS=120
# Dramatiq worker OS processes to fork (dramatiq --processes); shell-expanded at launch, not read by app code.
RWB_WORKER_PROCESSES=1
# Dramatiq worker threads per process (dramatiq --threads); shell-expanded at launch, not read by app code.
RWB_WORKER_THREADS=2
# Poller pass cadence in seconds (FR-027 / SC-001).
POLL_INTERVAL_SECS=15
# Submit-side retry ceiling (FR-029) and its exponential-backoff base in seconds.
IRP_SUBMISSION_MAX_RETRIES=3
IRP_SUBMISSION_RETRY_BASE_SECS=60
# Pinned currency defaults that pre-fill the execute-analysis modal's currency
# picker. Ops-edited only; the app never advances these when a newer vintage
# syncs. Leave DEFAULT_ANALYSIS_CURRENCY_VINTAGE empty for no pre-selection.
DEFAULT_ANALYSIS_CURRENCY_CODE=USD
DEFAULT_ANALYSIS_CURRENCY_SCHEME=RMS
DEFAULT_ANALYSIS_CURRENCY_VINTAGE=

# ── Notifications (Iteration 2) ───────────────────────────────────────────────
# Comma-separated channels to deliver completion/failure notices on:
# any of  teams,email,desktop . Leave empty to disable notifications.
NOTIFY_CHANNELS=
TEAMS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=
NOTIFY_EMAIL_TO=
