#!/usr/bin/env bash
# run_user_setup — interactive user provisioning CLI for Risk Workbench.
#
# Uses the deployed virtual environment directly; uv is not required.
#
# Usage:
#   ./infra/scripts/run_user_setup
#   make wsl-user-setup
set -euo pipefail
ROOT="${APP_DIR:-$(cd "$(dirname "$0")/../.." && pwd)}"
if [ ! -x "$ROOT/.venv/bin/python" ]; then
    echo "ERROR: $ROOT/.venv/bin/python not found; run rhel9-app-install.sh first." >&2
    exit 1
fi
if [ ! -f "$ROOT/infra/.env" ]; then
    echo "ERROR: $ROOT/infra/.env not found." >&2
    exit 1
fi
set -a
source "$ROOT/infra/.env"
set +a
cd "$ROOT"
exec .venv/bin/python -m infra.scripts.user_setup "$@"
